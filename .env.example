# =============================================================================
# YouTube Shorts Automation — Zero-Cost Environment Variables
# =============================================================================
# Copy this file to .env for local testing (never commit .env to GitHub).
# For automated runs, add these to your GitHub Repository Secrets.
#
# NO PAID SERVICES REQUIRED:
# - No S3 bucket needed (videos are rendered and streamed directly to YouTube)
# - No Telegram needed
# - No Database needed (no PostgreSQL / Prisma)
# =============================================================================

# ── Groq API (Required; Free tier has usage limits) ───────────────────────────
# Create an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── YouTube OAuth2 (Required for Upload - 100% Free) ──────────────────────────
# Base64-encoded JSON: {"client_id":"...","client_secret":"...","refresh_token":"..."}
# Generate on your PC with: python src/setup_oauth.py --client-secrets path/to/client_secrets.json
YOUTUBE_CREDENTIALS_JSON=your_base64_encoded_credentials_here

# ── Pexels Stock Video API (Optional - 100% Free) ─────────────────────────────
# Register free at https://www.pexels.com/api/ (20,000 free requests/month)
# If omitted, procedural high-res visual cards are generated automatically.
PEXELS_API_KEY=your_pexels_api_key_here

# ── NASA APOD API (Optional for Space niche - 100% Free) ──────────────────────
# Free key at https://api.nasa.gov/. Without this, falls back to DEMO_KEY.
NASA_API_KEY=DEMO_KEY
