# The Universe — Local Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.
# In production, all these are GitHub Actions Secrets.

# ── NASA ─────────────────────────────────────────────────────────────────────
# Register free at https://api.nasa.gov/
# Without this, falls back to DEMO_KEY (30 req/hour)
NASA_API_KEY=your_nasa_api_key_here

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube OAuth2 ────────────────────────────────────────────────────────────
# Base64-encoded JSON: {"client_id":"...","client_secret":"...","refresh_token":"..."}
# Generate with: python src/setup_oauth.py --client-secrets client_secrets.json
YOUTUBE_CREDENTIALS_JSON=your_base64_encoded_credentials_here
